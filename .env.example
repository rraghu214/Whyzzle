# ── LLM waterfall ─────────────────────────────────────────────────────────────
# Whyzzle tries each in order. You need at least ONE that works.

# 1. Google Gemini Flash — FREE (15 req/min, 1500 req/day)
#    Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Groq — FREE (30 req/min, 14 400 req/day), Llama 3.3 70B, ~2s latency ← RECOMMENDED
#    Get a free key (no card) at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Ollama (local, fully offline, no key needed — uses text-only lite prompt)
#    Install: https://ollama.com  then run: ollama pull gemma4:e4b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# 4. Anthropic Claude — paid fallback
#    Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=
